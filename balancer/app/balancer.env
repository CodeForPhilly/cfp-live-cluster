# Non-secret runtime config, rendered into ConfigMap balancer-config. The
# Deployment loads this AFTER the SealedSecret of the same name, so these win
# on any overlap; the Secret holds only SECRET_KEY, SQL_PASSWORD and API keys.
#
# DEBUG: settings.py does bool(os.environ.get("DEBUG", 0)), so any non-empty
# value — including "false" — turns debug ON. Empty = off. With debug off,
# runserver stops serving /static/ (the SPA bundle lives there), hence the
# --insecure flag patched onto the Deployment in kustomization.yaml.
DEBUG=
LOGIN_REDIRECT_URL=
REACT_APP_API_BASE_URL=https://balancertestsite.com/

# CloudNativePG shared-cluster (cloudnative-pg namespace). Database and role are
# declared in balancer/cnpg/ and _infra/cloudnative-pg/shared-cluster.yaml.
# Replaced the AWS RDS instance balancer-jj (database balancer_dev) on cutover.
SQL_ENGINE=django.db.backends.postgresql
SQL_HOST=shared-cluster-rw.cloudnative-pg.svc.cluster.local
SQL_PORT=5432
SQL_DATABASE=balancer
SQL_USER=balancer
